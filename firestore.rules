rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500));
    }

    function isValidTrip(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.from is string && data.from.size() > 0 && data.from.size() <= 100 &&
             data.to is string && data.to.size() > 0 && data.to.size() <= 100 &&
             data.distanceKm is number && data.distanceKm >= 0 &&
             data.passengers is int && data.passengers >= 1 &&
             data.vehicleType is string && data.vehicleType.size() > 0 &&
             data.fuelCost is number && data.fuelCost >= 0 &&
             data.tollCost is number && data.tollCost >= 0 &&
             data.parkingCost is number && data.parkingCost >= 0 &&
             data.foodOthers is number && data.foodOthers >= 0 &&
             data.totalCost is number && data.totalCost >= 0;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 50 &&
             data.paymentMethod is string && data.paymentMethod.size() > 0 && data.paymentMethod.size() <= 100;
    }

    function isValidContact(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 100;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Trips collection
    match /trips/{tripId} {
      allow get: if isSignedIn() && isValidId(tripId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(tripId) && request.resource.data.userId == request.auth.uid && isValidTrip(request.resource.data);
      allow update: if isSignedIn() && isValidId(tripId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTrip(request.resource.data);
      allow delete: if isSignedIn() && isValidId(tripId) && resource.data.userId == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(orderId) && request.resource.data.userId == request.auth.uid && isValidOrder(request.resource.data);
      allow update: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidOrder(request.resource.data);
      allow delete: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
    }

    // Emergency Contacts collection
    match /emergency_contacts/{contactId} {
      allow get: if isSignedIn() && isValidId(contactId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(contactId) && request.resource.data.userId == request.auth.uid && isValidContact(request.resource.data);
      allow update: if isSignedIn() && isValidId(contactId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidContact(request.resource.data);
      allow delete: if isSignedIn() && isValidId(contactId) && resource.data.userId == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
